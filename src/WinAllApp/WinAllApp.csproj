<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aplicativo WPF para .NET Framework 4.8 (Windows 7 SP1 até Windows 11).
       As telas são XAML "solto" embutido como recurso e carregado com XamlReader em tempo de execução,
       com toda a interação via bindings/comandos (MVVM). Assim o projeto compila com o SDK .NET em
       qualquer sistema (inclusive CI Linux), sem depender do compilador de marcação do Visual Studio. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>WinAllApp</RootNamespace>
    <AssemblyName>WinAllApp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!-- Executável único: o código do WinAllApp.Core é compilado dentro do .exe (sem DLL separada)
       e o config.json, a tela e o modo simulação vão embutidos como recursos. -->
  <ItemGroup>
    <Compile Include="..\WinAllApp.Core\**\*.cs" Exclude="..\WinAllApp.Core\obj\**;..\WinAllApp.Core\bin\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Views\*.xaml" LogicalName="WinAllApp.Views.%(Filename)%(Extension)" />
    <EmbeddedResource Include="config.json;config.simulacao.json" LogicalName="WinAllApp.Config.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\mock-installers\*.bat;..\..\mock-installers\*.txt" LogicalName="WinAllApp.Simulacao.%(Filename)%(Extension)" Link="mock-installers\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Sem WinAllApp.exe.config: o .NET 4.8 é usado por padrão. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
