<!--
  Tela principal. XAML "solto": sem x:Class nem eventos; tudo é ligado ao MainViewModel por bindings.
  Usa apenas controles nativos do WPF com cores sólidas (sem efeitos/transparências),
  para renderizar igual no tema Aero/Basic do Windows 7 e no Windows 10/11.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinAllApp · Instalação em Lote por Laboratório"
        Width="1040" Height="680" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFFFF"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolParaVisivel" />

    <!-- Verde do IFCE -->
    <SolidColorBrush x:Key="CorPrimaria" Color="#FF2F8A3F" />
    <SolidColorBrush x:Key="CorLateral" Color="#FFF1F4F8" />
    <SolidColorBrush x:Key="CorBorda" Color="#FFD5DBE3" />
    <SolidColorBrush x:Key="CorTextoSecundario" Color="#FF5B6573" />

    <Style x:Key="Rotulo" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Botao" TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource Botao}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="170" />
    </Style>

    <!-- Cor do texto de estado de cada programa -->
    <Style x:Key="EstadoTexto" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Instalando">
          <Setter Property="Foreground" Value="#FF2F8A3F" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Sucesso">
          <Setter Property="Foreground" Value="#FF1E7B34" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="SucessoReiniciar">
          <Setter Property="Foreground" Value="#FF8A5A00" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Falha">
          <Setter Property="Foreground" Value="#FFB3261E" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Cancelado">
          <Setter Property="Foreground" Value="#FF8A5A00" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Incompativel">
          <Setter Property="Foreground" Value="#FFB3261E" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ===== Rodapé: progresso e ações ===== -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="TextoStatus" Text="{Binding StatusTexto}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
          <ProgressBar x:Name="BarraProgresso" Height="14" Minimum="0" Maximum="100" Value="{Binding Progresso, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BotaoCancelar" Content="Cancelar" Style="{StaticResource Botao}"
                  Command="{Binding CancelarCommand}"
                  Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisivel}}" />
          <Button x:Name="BotaoInstalar" Style="{StaticResource BotaoPrimario}" Margin="0"
                  Command="{Binding InstalarCommand}">
            <TextBlock>
              <Run Text="Instalar selecionados (" /><Run Text="{Binding TotalSelecionados, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Menu lateral: 1) Bloco  2) Laboratório ===== -->
    <Border DockPanel.Dock="Left" Width="260" Background="{StaticResource CorLateral}"
            BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14" IsEnabled="{Binding PodeNavegar}">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <Image x:Name="ImagemLogo" DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,10,0" VerticalAlignment="Center"
                 ToolTip="IFCE · Campus Maracanaú" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="WinAllApp" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" />
            <TextBlock Text="Instalação em lote por laboratório" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <!-- Sistema detectado, pasta de rede e tutorial -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
          <TextBlock Text="Pasta de rede" Style="{StaticResource Rotulo}" />
          <TextBlock x:Name="TextoPastaRede" Text="{Binding PastaRedeStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PastaRedeAcessivel}" Value="True">
                    <Setter Property="Foreground" Value="#FF1E7B34" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding PastaRedeAcessivel}" Value="False">
                    <Setter Property="Foreground" Value="#FFB3261E" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="Sistema" Style="{StaticResource Rotulo}" Margin="0,6,0,6" />
          <TextBlock x:Name="TextoAmbiente" Text="{Binding ResumoAmbiente, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BotaoVerificarRede" Content="Verificar rede" Style="{StaticResource Botao}"
                    Command="{Binding VerificarPastaRedeCommand}" />
            <Button x:Name="BotaoTutorial" Content="Tutorial" Style="{StaticResource Botao}" Margin="0"
                    Command="{Binding AbrirTutorialCommand}" />
          </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="1. Bloco" Style="{StaticResource Rotulo}" />
        <ComboBox x:Name="ComboBlocos" DockPanel.Dock="Top" Margin="0,0,0,18" MinHeight="28"
                  ItemsSource="{Binding Blocos}" SelectedItem="{Binding BlocoSelecionado}"
                  DisplayMemberPath="Nome" />

        <TextBlock DockPanel.Dock="Top" Text="2. Laboratório" Style="{StaticResource Rotulo}" />
        <ListBox x:Name="ListaLaboratorios" ItemsSource="{Binding Laboratorios}"
                 SelectedItem="{Binding LaboratorioSelecionado}"
                 BorderBrush="{StaticResource CorBorda}" Background="#FFFFFFFF"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,5">
                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Foreground="{StaticResource CorTextoSecundario}" FontSize="12">
                  <Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Programas.Count, Mode=OneWay}" /><Run Text=" programa(s)" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===== Conteúdo: programas do laboratório escolhido ===== -->
    <Grid Margin="20,16,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock x:Name="TextoTitulo" Text="{Binding Titulo}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap" />
      </StackPanel>

      <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False"
                 Visibility="{Binding TemLaboratorio, Converter={StaticResource BoolParaVisivel}}">
        <Button x:Name="BotaoSelecionarTodos" DockPanel.Dock="Left" Content="Selecionar Todos do Laboratório"
                Style="{StaticResource Botao}" Command="{Binding SelecionarTodosCommand}" />
        <Button x:Name="BotaoLimpar" DockPanel.Dock="Left" Content="Limpar seleção"
                Style="{StaticResource Botao}" Command="{Binding LimparSelecaoCommand}" />
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding ResumoSelecao}"
                   Foreground="{StaticResource CorTextoSecundario}" />
      </DockPanel>

      <Border Grid.Row="2" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
        <Grid>
          <TextBlock x:Name="TextoAvisoVazio" Text="{Binding TextoAvisoVazio}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                     TextAlignment="Center" Foreground="{StaticResource CorTextoSecundario}"
                     Visibility="{Binding MostrarAvisoVazio, Converter={StaticResource BoolParaVisivel}}" />

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ListaProgramas" ItemsSource="{Binding Programas}" IsEnabled="{Binding PodeNavegar}"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selecionado}" VerticalContentAlignment="Center" ToolTip="{Binding Mensagem}">
                        <StackPanel Margin="6,0,0,0">
                          <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detalhe}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{StaticResource CorTextoSecundario}" />
                          <TextBlock Text="{Binding Observacao}" FontSize="12" TextWrapping="Wrap" FontStyle="Italic"
                                     Foreground="#FF8A5A00"
                                     Visibility="{Binding TemObservacao, Converter={StaticResource BoolParaVisivel}}" />
                          <TextBlock Text="{Binding AvisoCompatibilidade}" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"
                                     Foreground="#FFB3261E"
                                     Visibility="{Binding TemAvisoCompatibilidade, Converter={StaticResource BoolParaVisivel}}" />
                        </StackPanel>
                      </CheckBox>
                      <TextBlock Grid.Column="1" Text="{Binding EstadoTexto}" Style="{StaticResource EstadoTexto}"
                                 Margin="12,0,0,0" ToolTip="{Binding Mensagem}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Expander Grid.Row="3" Header="Registro da instalação" Margin="0,10,0,0">
        <ListBox x:Name="ListaLog" ItemsSource="{Binding Log}" Height="120" FontFamily="Consolas" FontSize="12"
                 BorderBrush="{StaticResource CorBorda}" />
      </Expander>
    </Grid>
  </DockPanel>
</Window>
