<!--
  Tela principal. XAML "solto": sem x:Class nem eventos; tudo é ligado ao MainViewModel por bindings.
  Usa apenas controles nativos do WPF com cores sólidas (sem efeitos/transparências),
  para renderizar igual no tema Aero/Basic do Windows 7 e no Windows 10/11.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinAllApp · Instalação em Lote por Laboratório"
        Width="1040" Height="680" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFFFFFFF"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolParaVisivel" />

    <!-- Verde do IFCE -->
    <SolidColorBrush x:Key="CorPrimaria" Color="#FF2F8A3F" />
    <SolidColorBrush x:Key="CorLateral" Color="#FFF1F4F8" />
    <SolidColorBrush x:Key="CorBorda" Color="#FFD5DBE3" />
    <SolidColorBrush x:Key="CorTextoSecundario" Color="#FF5B6573" />

    <Style x:Key="Rotulo" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Botao" TargetType="Button">
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource Botao}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="170" />
    </Style>

    <SolidColorBrush x:Key="CorErro" Color="#FFB3261E" />
    <SolidColorBrush x:Key="CorFundoErro" Color="#FFFDECEA" />

    <!--
      Spinner: um arco girando enquanto o elemento está visível (a animação para quando ele some).
      Cada spinner declara o próprio RotateTransform (não congelado) para poder ser animado.
      Sem x:Name no BeginStoryboard: no XAML carregado pelo XamlReader o nome não entra no escopo do Style.
      Para parar, a saída inicia uma animação instantânea que substitui a infinita (SnapshotAndReplace) e se remove.
    -->
    <Style x:Key="Spinner" TargetType="Grid">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsVisible" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
              <Storyboard FillBehavior="Stop">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                 To="0" Duration="0" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Spinner pequeno da linha que está sendo instalada -->
    <Style x:Key="SpinnerItem" TargetType="Grid" BasedOn="{StaticResource Spinner}">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Instalando">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Linha do programa: fundo vermelho claro quando a instalação falhou -->
    <Style x:Key="LinhaPrograma" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="Transparent" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding TemFalha}" Value="True">
          <Setter Property="Background" Value="{StaticResource CorFundoErro}" />
          <Setter Property="BorderBrush" Value="#FFF2B8B5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Cor do texto de estado de cada programa -->
    <Style x:Key="EstadoTexto" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Instalando">
          <Setter Property="Foreground" Value="#FF2F8A3F" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Sucesso">
          <Setter Property="Foreground" Value="#FF1E7B34" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="SucessoReiniciar">
          <Setter Property="Foreground" Value="#FF8A5A00" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Falha">
          <Setter Property="Foreground" Value="#FFB3261E" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Cancelado">
          <Setter Property="Foreground" Value="#FF8A5A00" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Incompativel">
          <Setter Property="Foreground" Value="#FFB3261E" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- ===== Rodapé: progresso e ações ===== -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <DockPanel Margin="0,0,0,6">
            <!-- Spinner da instalação: gira enquanto a fila roda em segundo plano (a janela continua respondendo) -->
            <Grid x:Name="SpinnerInstalacao" DockPanel.Dock="Left" Style="{StaticResource Spinner}" Margin="0,0,8,0"
                  Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisivel}}" ToolTip="Instalando…">
              <Grid.RenderTransform>
                <RotateTransform />
              </Grid.RenderTransform>
              <Ellipse Stroke="{StaticResource CorBorda}" StrokeThickness="3" />
              <Path Data="M9,1.5 A7.5,7.5 0 0 1 16.5,9" Stroke="{StaticResource CorPrimaria}" StrokeThickness="3"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
            <!-- Contador: concluídos de total · instalados · falhas -->
            <TextBlock x:Name="TextoContador" DockPanel.Dock="Right" Text="{Binding ContadorTexto}" Margin="12,0,0,0"
                       VerticalAlignment="Center" Visibility="{Binding TemContador, Converter={StaticResource BoolParaVisivel}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="{StaticResource CorPrimaria}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TemFalhas}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource CorErro}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="TextoStatus" Text="{Binding StatusTexto}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <ProgressBar x:Name="BarraProgresso" Height="14" Minimum="0" Maximum="100" Value="{Binding Progresso, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BotaoCancelar" Content="Cancelar" Style="{StaticResource Botao}"
                  Command="{Binding CancelarCommand}"
                  Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisivel}}" />
          <Button x:Name="BotaoInstalar" Style="{StaticResource BotaoPrimario}" Margin="0"
                  Command="{Binding InstalarCommand}">
            <TextBlock>
              <Run Text="Instalar selecionados (" /><Run Text="{Binding TotalSelecionados, Mode=OneWay}" /><Run Text=")" />
            </TextBlock>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Menu lateral: 1) Bloco  2) Laboratório ===== -->
    <Border DockPanel.Dock="Left" Width="260" Background="{StaticResource CorLateral}"
            BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14" IsEnabled="{Binding PodeNavegar}">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <Image x:Name="ImagemLogo" DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,10,0" VerticalAlignment="Center"
                 ToolTip="IFCE · Campus Maracanaú" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="WinAllApp" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource CorPrimaria}" />
            <TextBlock Text="Instalação em lote por laboratório" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>

        <!-- Sistema detectado, pasta de rede e tutorial -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
          <TextBlock Text="Sistema" Style="{StaticResource Rotulo}" />
          <TextBlock x:Name="TextoAmbiente" Text="{Binding ResumoAmbiente, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BotaoTutorial" Content="Tutorial" Style="{StaticResource Botao}" Margin="0"
                    Command="{Binding AbrirTutorialCommand}" />
          </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="1. Bloco" Style="{StaticResource Rotulo}" />
        <ComboBox x:Name="ComboBlocos" DockPanel.Dock="Top" Margin="0,0,0,18" MinHeight="28"
                  ItemsSource="{Binding Blocos}" SelectedItem="{Binding BlocoSelecionado}"
                  DisplayMemberPath="Nome" />

        <TextBlock DockPanel.Dock="Top" Text="2. Laboratório" Style="{StaticResource Rotulo}" />
        <ListBox x:Name="ListaLaboratorios" ItemsSource="{Binding Laboratorios}"
                 SelectedItem="{Binding LaboratorioSelecionado}"
                 BorderBrush="{StaticResource CorBorda}" Background="#FFFFFFFF"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,5">
                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Foreground="{StaticResource CorTextoSecundario}" FontSize="12">
                  <Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Programas.Count, Mode=OneWay}" /><Run Text=" programa(s)" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===== Conteúdo: programas do laboratório escolhido ===== -->
    <Grid Margin="20,16,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock x:Name="TextoTitulo" Text="{Binding Titulo}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Pasta de rede: editável, com o caminho do config.json. Verificar roda em segundo plano (spinner ao lado). -->
      <Border Grid.Row="1" Background="{StaticResource CorLateral}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1"
              Padding="12,8" Margin="0,0,0,10">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="Pasta de rede" Style="{StaticResource Rotulo}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <Button x:Name="BotaoVerificarRede" DockPanel.Dock="Right" Content="Verificar" Style="{StaticResource Botao}" Margin="8,0,0,0"
                    Command="{Binding VerificarPastaRedeCommand}" ToolTip="Testa se a pasta responde (sem travar a janela)" />
            <Grid x:Name="SpinnerRede" DockPanel.Dock="Right" Style="{StaticResource Spinner}" Margin="8,0,0,0"
                  Visibility="{Binding VerificandoPastaRede, Converter={StaticResource BoolParaVisivel}}" ToolTip="Verificando a pasta de rede…">
              <Grid.RenderTransform>
                <RotateTransform />
              </Grid.RenderTransform>
              <Ellipse Stroke="{StaticResource CorBorda}" StrokeThickness="3" />
              <Path Data="M9,1.5 A7.5,7.5 0 0 1 16.5,9" Stroke="{StaticResource CorPrimaria}" StrokeThickness="3"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
            <TextBox x:Name="CampoPastaRede" Text="{Binding PastaRede, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding PodeNavegar}" MinHeight="28" VerticalContentAlignment="Center" Padding="4,0"
                     ToolTip="Caminho da pasta de rede com os instaladores (ex.: \\servidor\pasta). Pode ser editado antes de instalar." />
          </DockPanel>
          <TextBlock x:Name="TextoPastaRede" Text="{Binding PastaRedeStatus}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding PastaRedeAcessivel}" Value="True">
                    <Setter Property="Foreground" Value="#FF1E7B34" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding PastaRedeAcessivel}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource CorErro}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Alerta vermelho: pasta de rede inacessível, programas que falharam ou erro inesperado -->
      <Border x:Name="FaixaErro" Grid.Row="2" Background="{StaticResource CorFundoErro}" BorderBrush="{StaticResource CorErro}"
              BorderThickness="1" Padding="10,8" Margin="0,0,0,10"
              Visibility="{Binding TemErro, Converter={StaticResource BoolParaVisivel}}">
        <DockPanel>
          <Grid DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,10,0">
            <Ellipse Fill="{StaticResource CorErro}" />
            <Path Data="M10,5 L10,11.5 M10,14.8 L10,15" Stroke="#FFFFFFFF" StrokeThickness="2.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Grid>
          <Button x:Name="BotaoFecharErro" DockPanel.Dock="Right" Content="Fechar" Padding="10,2" Margin="10,0,0,0"
                  VerticalAlignment="Top" Command="{Binding FecharErroCommand}" />
          <TextBlock x:Name="TextoErro" Text="{Binding MensagemErro}" TextWrapping="Wrap" FontWeight="SemiBold"
                     Foreground="#FF8C1D18" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- Barra de pesquisa: filtra a lista em tempo real (SearchText no ViewModel), sem desmarcar nada -->
      <Grid x:Name="BarraPesquisa" Grid.Row="3" Margin="0,0,0,10"
            Visibility="{Binding TemLaboratorio, Converter={StaticResource BoolParaVisivel}}">
        <TextBox x:Name="CampoPesquisa" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="30" VerticalContentAlignment="Center" Padding="26,0,30,0"
                 ToolTip="Filtra pelo nome, versão ou categoria. Os programas marcados continuam marcados." />
        <Path Data="M6.5,1 A5.5,5.5 0 1 1 6.49,1 Z M10.5,10.5 L15,15" Stroke="{StaticResource CorTextoSecundario}" StrokeThickness="1.6"
              Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"
              StrokeEndLineCap="Round" IsHitTestVisible="False" />
        <TextBlock Text="Pesquisar programa neste laboratório…" Margin="30,0,0,0" VerticalAlignment="Center"
                   Foreground="#FF8A93A0" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding SearchText}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button x:Name="BotaoLimparPesquisa" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                Width="24" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                ToolTip="Limpar pesquisa" Command="{Binding LimparPesquisaCommand}"
                Visibility="{Binding TemPesquisa, Converter={StaticResource BoolParaVisivel}}">
          <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource CorTextoSecundario}" StrokeThickness="1.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
      </Grid>

      <DockPanel Grid.Row="4" Margin="0,0,0,10" LastChildFill="False"
                 Visibility="{Binding TemLaboratorio, Converter={StaticResource BoolParaVisivel}}">
        <Button x:Name="BotaoSelecionarTodos" DockPanel.Dock="Left" Content="{Binding TextoSelecionarTodos}"
                Style="{StaticResource Botao}" Command="{Binding SelecionarTodosCommand}" />
        <Button x:Name="BotaoLimpar" DockPanel.Dock="Left" Content="Limpar seleção"
                Style="{StaticResource Botao}" Command="{Binding LimparSelecaoCommand}" />
        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding ResumoSelecao}"
                   Foreground="{StaticResource CorTextoSecundario}" />
      </DockPanel>

      <Border Grid.Row="5" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
        <Grid>
          <TextBlock x:Name="TextoAvisoVazio" Text="{Binding TextoAvisoVazio}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"
                     TextAlignment="Center" Foreground="{StaticResource CorTextoSecundario}"
                     Visibility="{Binding MostrarAvisoVazio, Converter={StaticResource BoolParaVisivel}}" />

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ListaProgramas" ItemsSource="{Binding ProgramasVisiveis}" IsEnabled="{Binding PodeNavegar}"
                          KeyboardNavigation.TabNavigation="Continue">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource LinhaPrograma}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selecionado}" VerticalContentAlignment="Center" ToolTip="{Binding Mensagem}">
                        <StackPanel Margin="6,0,0,0">
                          <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Detalhe}" FontSize="12" TextWrapping="Wrap"
                                     Foreground="{StaticResource CorTextoSecundario}" />
                          <TextBlock Text="{Binding Observacao}" FontSize="12" TextWrapping="Wrap" FontStyle="Italic"
                                     Foreground="#FF8A5A00"
                                     Visibility="{Binding TemObservacao, Converter={StaticResource BoolParaVisivel}}" />
                          <TextBlock Text="{Binding AvisoCompatibilidade}" FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold"
                                     Foreground="#FFB3261E"
                                     Visibility="{Binding TemAvisoCompatibilidade, Converter={StaticResource BoolParaVisivel}}" />
                          <TextBlock FontSize="12" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource CorErro}"
                                     Visibility="{Binding MostrarMensagemErro, Converter={StaticResource BoolParaVisivel}}">
                            <Run Text="Motivo: " /><Run Text="{Binding Mensagem, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </CheckBox>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Grid Style="{StaticResource SpinnerItem}" Margin="0,0,6,0">
                          <Grid.RenderTransform>
                            <RotateTransform />
                          </Grid.RenderTransform>
                          <Ellipse Stroke="{StaticResource CorBorda}" StrokeThickness="2.5" />
                          <Path Data="M7,1.25 A5.75,5.75 0 0 1 12.75,7" Stroke="{StaticResource CorPrimaria}" StrokeThickness="2.5"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <!-- Ícone vermelho de falha -->
                        <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{Binding Mensagem}"
                              Visibility="{Binding TemFalha, Converter={StaticResource BoolParaVisivel}}">
                          <Ellipse Fill="{StaticResource CorErro}" />
                          <Path Data="M5,5 L11,11 M11,5 L5,11" Stroke="#FFFFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Text="{Binding EstadoTexto}" Style="{StaticResource EstadoTexto}" ToolTip="{Binding Mensagem}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Expander Grid.Row="6" Header="Registro da instalação" Margin="0,10,0,0">
        <ListBox x:Name="ListaLog" ItemsSource="{Binding Log}" Height="120" FontFamily="Consolas" FontSize="12"
                 BorderBrush="{StaticResource CorBorda}" />
      </Expander>
    </Grid>
  </DockPanel>
</Window>
